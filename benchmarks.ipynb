    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"from torchvision.ops import box_iou\\n\",\n",
    "    \"\\n\",\n",
    "    \"def smoke_IoU_folder(model_name):\\n\",\n",
    "    \"    processor = AutoProcessor.from_pretrained(model_name)\\n\",\n",
    "    \"    model = AutoModelForZeroShotObjectDetection.from_pretrained(model_name).to(device)\\n\",\n",
    "    \"    labeled_folder = './dataset/labeled_data/Annotation'\\n\",\n",
    "    \"    TP = 0\\n\",\n",
    "    \"    FP = 0\\n\",\n",
    "    \"    FN = 0\\n\",\n",
    "    \"    total_iou = 0.0\\n\",\n",
    "    \"    matched_count = 0\\n\",\n",
    "    \"    for dir in tqdm(os.listdir(labeled_folder), desc=\\\"Walking folders\\\", unit=\\\"dir\\\"):\\n\",\n",
    "    \"        original_path = os.path.join('./dataset/all', dir)\\n\",\n",
    "    \"        label_path = os.path.join(labeled_folder, dir)\\n\",\n",
    "    \"        for filename in os.listdir(label_path):\\n\",\n",
    "    \"            original_image_name = filename.replace(\\\".json\\\", \\\".jpg\\\")\\n\",\n",
    "    \"            image_path = os.path.join(original_path, original_image_name)\\n\",\n",
    "    \"            predict_box = get_box(image_path, model, processor)\\n\",\n",
    "    \"            with open(os.path.join(label_path, filename), \\\"r\\\") as f:\\n\",\n",
    "    \"                data = json.load(f)\\n\",\n",
    "    \"                label_box = torch.tensor(data[\\\"det_boxes\\\"]).float().to(device)\\n\",\n",
    "    \"                if predict_box.shape[0] == 0:\\n\",\n",
    "    \"                    FN += label_box.shape[0]\\n\",\n",
    "    \"                    continue\\n\",\n",
    "    \"                if label_box.shape[0] == 0:\\n\",\n",
    "    \"                    FP += predict_box.shape[0]\\n\",\n",
    "    \"                    continue\\n\",\n",
    "    \"                iou_matrix = box_iou(predict_box, label_box)\\n\",\n",
    "    \"                best_iou_per_pred, matched_gt_idx = iou_matrix.max(dim=1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"                matched_mask = best_iou_per_pred >= 0.5\\n\",\n",
    "    \"                total_iou += best_iou_per_pred[matched_mask].sum().item()\\n\",\n",
    "    \"                matched_count += matched_mask.sum().item()\\n\",\n",
    "    \"\\n\",\n",
    "    \"                per_image_TP = (best_iou_per_pred >= 0.5).sum().item()\\n\",\n",
    "    \"                per_image_FP = (best_iou_per_pred < 0.5).sum().item()\\n\",\n",
    "    \"                per_image_FN = label_box.shape[0] - per_image_TP\\n\",\n",
    "    \"\\n\",\n",
    "    \"                TP += per_image_TP\\n\",\n",
    "    \"                FP += per_image_FP\\n\",\n",
    "    \"                FN += per_image_FN\\n\",\n",
    "    \"    precision = TP / (TP + FP)\\n\",\n",
    "    \"    recall = TP / (TP + FN)\\n\",\n",
    "    \"    mean_iou = total_iou / (matched_count + 1e-6)\\n\",\n",
    "    \"    print(\\\"Precision:\\\", precision)\\n\",\n",
    "    \"    print(\\\"Recall:\\\", recall)\\n\",\n",
    "    \"    print(f\\\"Mean IoU (on TP): {mean_iou:.4f}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"def get_box(image_path, model, processor):\\n\",\n",
    "    \"    image = Image.open(image_path)\\n\",\n",
    "    \"    text_labels = [[\\\"smoke\\\"]]\\n\",\n",
    "    \"    inputs = processor(image, text_labels, return_tensors=\\\"pt\\\").to(device)\\n\",\n",
    "    \"    with torch.no_grad():\\n\",\n",
    "    \"        outputs = model(**inputs)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    results = processor.post_process_grounded_object_detection(\\n\",\n",
    "    \"        outputs,\\n\",\n",
    "    \"        inputs.input_ids,\\n\",\n",
    "    \"        box_threshold=0.3,\\n\",\n",
    "    \"        text_threshold=0.3,\\n\",\n",
    "    \"        target_sizes=[image.size[::-1]],\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    return results[0][\\\"boxes\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"model_id = \\\"IDEA-Research/grounding-dino-base\\\"\\n\",\n",
    "    \"smoke_IoU_folder(model_id)\\n\"\n",
    "   ],\n",
