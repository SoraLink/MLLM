    "   \"source\": [\n",
    "    \"import json\\n\",\n",
    "    \"\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"from tqdm import tqdm\\n\",\n",
    "    \"import os\\n\",\n",
    "    \"import torch\\n\",\n",
    "    \"import transformers\\n\",\n",
    "    \"from transformers import AutoProcessor, AutoModelForZeroShotObjectDetection\\n\",\n",
    "    \"from PIL import Image\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"#加载\\n\",\n",
    "    \"\\n\",\n",
    "    \"device = \\\"cuda\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def grounding_smoke(image_path, model, processor):\\n\",\n",
    "    \"    image = Image.open(image_path)\\n\",\n",
    "    \"    text_labels = [[\\\"smoke\\\"]]\\n\",\n",
    "    \"    inputs = processor(image, text_labels, return_tensors=\\\"pt\\\").to(device)\\n\",\n",
    "    \"    with torch.no_grad():\\n\",\n",
    "    \"        outputs = model(**inputs)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    results = processor.post_process_grounded_object_detection(\\n\",\n",
    "    \"        outputs,\\n\",\n",
    "    \"        inputs.input_ids,\\n\",\n",
    "    \"        box_threshold=0.3,\\n\",\n",
    "    \"        text_threshold=0.3,\\n\",\n",
    "    \"        target_sizes=[image.size[::-1]],\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    result = results[0]\\n\",\n",
    "    \"    print(result)\\n\",\n",
    "    \"    plt.figure(figsize=(10, 10))\\n\",\n",
    "    \"    plt.imshow(image)\\n\",\n",
    "    \"    ax = plt.gca()\\n\",\n",
    "    \"    for box, score, label in zip(result[\\\"boxes\\\"], result[\\\"scores\\\"], result[\\\"labels\\\"]):\\n\",\n",
    "    \"        x0, y0, x1, y1 = box.tolist()\\n\",\n",
    "    \"        ax.add_patch(plt.Rectangle((x0, y0), x1 - x0, y1 - y0, fill=False, color=\\\"r\\\", linewidth=3))\\n\",\n",
    "    \"        ax.text(x0, y0, label, fontsize=15, color=\\\"white\\\")\\n\",\n",
    "    \"        plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"def grounding_image_folder(model_name):\\n\",\n",
    "    \"    processor = AutoProcessor.from_pretrained(model_name)\\n\",\n",
    "    \"    model = AutoModelForZeroShotObjectDetection.from_pretrained(model_name).to(device)\\n\",\n",
    "    \"    folder = \\\"./confused_images\\\"\\n\",\n",
    "    \"    for filename in os.listdir(folder):\\n\",\n",
    "    \"        grounding_smoke(os.path.join(folder, filename), model, processor)\\n\",\n",
    "    \"\\n\",\n",
    "    \"def classification_smoke_folder(model_name, folder):\\n\",\n",
    "    \"    processor = AutoProcessor.from_pretrained(model_name)\\n\",\n",
    "    \"    model = AutoModelForZeroShotObjectDetection.from_pretrained(model_name).to(device)\\n\",\n",
    "    \"    total = 0\\n\",\n",
    "    \"    correct = 0\\n\",\n",
    "    \"    for root, dirs, files in tqdm(os.walk(folder), desc=\\\"Walking folders\\\", unit=\\\"dir\\\"):\\n\",\n",
    "    \"        for file in files:\\n\",\n",
    "    \"            if file.lower().endswith(\\\".jpg\\\"):\\n\",\n",
    "    \"                if len(file.lower().split(\\\"_\\\")) <= 1:\\n\",\n",
    "    \"                    print(\\\"Skipping {}\\\".format(os.path.join(root, file)))\\n\",\n",
    "    \"                    continue\\n\",\n",
    "    \"                label = file.lower().split(\\\"_\\\")[1].replace(\\\".jpg\\\", \\\"\\\")\\n\",\n",
    "    \"                is_smoke = label.startswith(\\\"+\\\")\\n\",\n",
    "    \"                time = int(label[1:])\\n\",\n",
    "    \"                if is_smoke or time > 1000:\\n\",\n",
    "    \"                    continue\\n\",\n",
    "    \"                image_path = os.path.join(root, file)\\n\",\n",
    "    \"                try:\\n\",\n",
    "    \"                    prediction = classify_smoke(image_path, model, processor)\\n\",\n",
    "    \"                except Exception as e:\\n\",\n",
    "    \"                    print(e)\\n\",\n",
    "    \"                    continue\\n\",\n",
    "    \"                total += 1\\n\",\n",
    "    \"                if prediction is True:\\n\",\n",
    "    \"                    correct += 1\\n\",\n",
    "    \"    accuracy = correct / total\\n\",\n",
    "    \"    print(f\\\"Accuracy: {accuracy}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"def classify_smoke(image_path, model, processor):\\n\",\n",
    "    \"    image = Image.open(image_path)\\n\",\n",
    "    \"    text_labels = [[\\\"smoke\\\"]]\\n\",\n",
    "    \"    inputs = processor(image, text_labels, return_tensors=\\\"pt\\\").to(device)\\n\",\n",
    "    \"    with torch.no_grad():\\n\",\n",
    "    \"        outputs = model(**inputs)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    results = processor.post_process_grounded_object_detection(\\n\",\n",
    "    \"        outputs,\\n\",\n",
    "    \"        inputs.input_ids,\\n\",\n",
    "    \"        box_threshold=0.3,\\n\",\n",
    "    \"        text_threshold=0.3,\\n\",\n",
    "    \"        target_sizes=[image.size[::-1]],\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    return len(results[0]['labels']) == 0\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def compute_iou(box1, box2):\\n\",\n",
    "    \"    x1 = max(box1[0], box2[0])\\n\",\n",
    "    \"    y1 = max(box1[1], box2[1])\\n\",\n",
    "    \"    x2 = min(box1[2], box2[2])\\n\",\n",
    "    \"    y2 = min(box1[3], box2[3])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    inter_area = max(0, x2 - x1) * max(0, y2 - y1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    area1 = (box1[2] - box1[0]) * (box1[3] - box1[1])\\n\",\n",
    "    \"    area2 = (box2[2] - box2[0]) * (box2[3] - box2[1])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    union_area = area1 + area2 - inter_area\\n\",\n",
    "    \"    return inter_area / union_area if union_area > 0 else 0\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# model name\\n\",\n",
    "    \"# IDEA-Research/grounding-dino-base\\n\",\n",
    "    \"model_id = \\\"IDEA-Research/grounding-dino-base\\\"\\n\",\n",
    "    \"# grounding_image_folder(model_id)\\n\",\n",
    "    \"folder = \\\"./dataset/rgb\\\"\\n\",\n",
